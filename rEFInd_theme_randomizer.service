[Unit]
Description=Randomize Theme on each rEFInd boot

[Service]
Type=oneshot
RemainAfterExit=yes
# The root-owned helper binary (installed by the package into /etc/rEFInd);
# a root unit must never execute a path the desktop user can write.
ExecStart=/etc/rEFInd/rEFInd_GUI_helper randomize-theme

[Install]
WantedBy=multi-user.target
