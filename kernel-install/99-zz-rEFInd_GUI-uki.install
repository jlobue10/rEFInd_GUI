#!/bin/sh
# kernel-install plugin shipped by rEFInd_GUI.
#
# rEFInd_GUI writes manual boot stanzas only (`scanfor manual`), so a Boot
# Option slot that boots a Unified Kernel Image names the image by path --
# and kernel-install names UKIs <entry-token>-<kernel-version>.efi and
# deletes old ones as kernels rotate. After every kernel add/remove this
# plugin has the root helper re-point the marked UKI stanzas in the live
# refind.conf at the images that exist now (newest as the loader, older
# ones as submenu entries). Nothing else in refind.conf is touched.
#
# Fedora's uki-direct also gives every new UKI its own firmware entry and
# points BootNext at it (and its boot-success service then moves that entry
# to the front of BootOrder), so the firmware would boot the new kernel
# directly and skip rEFInd. After an update the helper hands the boot
# priority back: it clears a BootNext that targets a UKI entry and moves
# rEFInd's entry back to the front when a UKI entry was put ahead of it.
# Nothing else in NVRAM is touched, and only when refind.conf has UKI
# stanzas written by rEFInd_GUI.
#
# The "99-zz" name makes this run last -- after 90-uki-copy.install has
# copied or removed the image and after uki-direct's 99-uki-uefi-setup.install
# has moved it to the ESP and set BootNext. It must never fail a kernel
# install: every problem is a warning.

COMMAND="${1:-}"

case "$COMMAND" in
    # Only kernel-install's UKI layout adds versioned /EFI/Linux images.
    add) [ "${KERNEL_INSTALL_LAYOUT:-}" = "uki" ] || exit 0 ;;
    # A remove carries no layout (kernel-install reports "other" there), and
    # a removed UKI must leave the menu either way; the helper returns at
    # once when refind.conf has no UKI stanzas.
    remove) ;;
    *) exit 0 ;;
esac

HELPER=/etc/rEFInd/rEFInd_GUI_helper
[ -x "$HELPER" ] || exit 0

# On a remove, name the kernel going away: its modules are still on disk
# while kernel-install runs, and Fedora's kernel package removes with
# --entry-type=type1, which makes 90-uki-copy.install leave its UKI behind.
KERNEL_VERSION="${2:-}"
if [ "$COMMAND" = "remove" ] && [ -n "$KERNEL_VERSION" ]; then
    set -- uki-refresh "$KERNEL_VERSION"
else
    set -- uki-refresh
fi

if ! "$HELPER" "$@"; then
    echo "rEFInd_GUI: could not re-point the rEFInd UKI boot entries;" \
         "use Create Config and Install Config in rEFInd_GUI." >&2
fi
exit 0
